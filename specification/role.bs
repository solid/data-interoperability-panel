      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>ldp:contains</td>
      <td>[Role](#classRole)</td>
      <td>[=Role=] in the [=Role Registry=]</td>
    </tr>
  </tbody>
</table>

